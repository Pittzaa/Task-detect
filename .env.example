# Copy to .env.local and fill in. Never commit real values. Full reference: docs/ENVIRONMENT.md
# A blank value counts as "not set".

# --- Deployment tier: production | staging | development | test | e2e (leave unset for the default)
# APP_ENV=
# Public origin, no trailing slash. https in production.
APP_URL=http://localhost:3000

# --- Database (Neon). Runtime role must be NOSUPERUSER NOBYPASSRLS.
# Pooled connection string for the runtime role:
DATABASE_URL=
# Direct (non-pooled) connection string for the OWNER role: migrations, bootstrap, backups only.
DATABASE_URL_UNPOOLED=
LOG_LEVEL=info

# --- Secrets (required in production)
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# openssl rand -base64 32   (losing it makes stored webhooks / calendar tokens unreadable)
APP_ENCRYPTION_KEY=
# Only while rotating keys, see docs/SECURITY.md
# APP_ENCRYPTION_KEY_PREVIOUS=
# openssl rand -hex 24   (cron + readiness endpoints)
CRON_SECRET=

# --- E-mail (Resend) (required in production)
RESEND_API_KEY=
EMAIL_FROM=

# --- Google (optional; set both of a pair or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Attachments (Vercel Blob, private store)
BLOB_READ_WRITE_TOKEN=

# --- Development / E2E only. Rejected in production.
# EMAIL_SINK_FILE=.data/emails.jsonl
