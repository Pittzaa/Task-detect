{
  "name": "task-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "privacy": "tsx scripts/privacy.ts",
    "org": "tsx scripts/org-transfer.ts",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:browsers": "pnpm build && bash scripts/e2e-browsers.sh",
    "load": "tsx scripts/load-test.ts",
    "e2e:setup": "tsx scripts/e2e-setup.ts",
    "backup:restore-test": "tsx scripts/backup-restore-test.ts",
    "verify:attachments": "tsx scripts/verify-attachments.ts",
    "backup:attachments": "tsx scripts/backup-attachments.ts",
    "verify:database": "tsx scripts/verify-database.ts",
    "smoke": "tsx scripts/smoke.ts",
    "rotate:key": "tsx scripts/rotate-encryption-key.ts",
    "docs:generate": "tsx scripts/gen-docs.ts",
    "docs:erd": "tsx scripts/gen-erd.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@better-auth/utils": "^0.5.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
